# Copy to .env to override. All values below are safe local defaults, not secrets.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

BACKEND_PORT=8080
FRONTEND_PORT=5173

# Origin allowed to call the backend from a browser.
CORS_ORIGIN=http://localhost:5173
# Base URL the frontend bundle is built with (baked in at build time).
VITE_API_BASE=http://localhost:8080
